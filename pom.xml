<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.quest.foglight</groupId>
    <artifactId>foglight-databricks-agent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <foglight.lib>${project.basedir}/lib/foglight</foglight.lib>
    </properties>

    <dependencies>
        <!-- Foglight agent APIs — provided by FglAM at runtime; jars bundled in lib/foglight/ -->
        <dependency>
            <groupId>com.quest.glue</groupId>
            <artifactId>glueapi</artifactId>
            <version>8.2.0.0</version>
            <scope>system</scope>
            <systemPath>${foglight.lib}/glueapi.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.quest.glue</groupId>
            <artifactId>gluecommon</artifactId>
            <version>8.2.0.0</version>
            <scope>system</scope>
            <systemPath>${foglight.lib}/gluecommon.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.quest.agent</groupId>
            <artifactId>agent-common</artifactId>
            <version>5.8.0</version>
            <scope>system</scope>
            <systemPath>${foglight.lib}/agent-common-5.8.0.jar</systemPath>
        </dependency>

        <!-- Jackson — bundled in agent lib dir since agent classloader isolation -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.16.1</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>databricks-agent</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <descriptors>
                        <descriptor>assembly.xml</descriptor>
                    </descriptors>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>agent-package</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
